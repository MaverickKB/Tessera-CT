{
  "comment": "Patterns for scripts/check_release_privacy.py. This file is public input: it describes classes of private data, never a private value. Extra literal terms belong in the gitignored release/privacy_terms.local.txt.",
  "copyright_line": "^[ \t]*(?:Required Notice: )?Copyright [0-9]{4} [A-Z].*$",
  "skip_suffixes": [
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".ico",
    ".svg",
    ".pdf",
    ".zip",
    ".gz",
    ".tar",
    ".tgz",
    ".whl",
    ".woff",
    ".woff2",
    ".ttf",
    ".otf",
    ".pyc",
    ".lock"
  ],
  "allowed_email_domains": [
    "example.com",
    "example.invalid",
    "example.net",
    "example.org",
    "localhost"
  ],
  "allowed_matches": [
    "/Users/someone",
    "/Users/example",
    "/Users/<",
    "/Users/[A-Za-z]",
    "/Users/(someone|example)",
    "/home/example",
    "/home/[a-z]"
  ],
  "patterns": [
    {
      "label": "user home path",
      "regex": "(?<![A-Za-z0-9])/(?:Users|home)/"
    },
    {
      "label": "private IPv4 address",
      "regex": "(?<![0-9.])(?:10\\.[0-9]{1,3}|192\\.168|172\\.(?:1[6-9]|2[0-9]|3[01]))\\.[0-9]{1,3}\\.[0-9]{1,3}(?![0-9.])"
    },
    {
      "label": "tailnet IPv4 address",
      "regex": "(?<![0-9.])100\\.(?:6[4-9]|[7-9][0-9]|1[0-2][0-9])\\.[0-9]{1,3}\\.[0-9]{1,3}(?![0-9.])"
    },
    {
      "label": "mDNS hostname",
      "regex": "(?<![.\\w\\[-])[A-Za-z0-9][A-Za-z0-9-]*\\.local(?![\\w.(\\-])"
    },
    {
      "label": "email address",
      "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}"
    }
  ]
}
