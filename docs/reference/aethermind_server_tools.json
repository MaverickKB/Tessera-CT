[
 {
  "name": "prepare_inheritance",
  "description": "Read a native AetherMind inheritance envelope on this filesystem host.\n\n    Retains whole records, currentness, correction debt, omissions and separate\n    authored texture. Budget is native characters; load-bearing records may\n    overflow. With no anchor this explicitly requests full native inheritance;\n    use discover_inheritance first when task scope is unknown. No store is\n    initialized or written. Preparing a packet grants no action authority and\n    does not prove delivery, recognition, application or comprehension.\n    ",
  "inputSchema": {
   "properties": {
    "project_root": {
     "title": "Project Root",
     "type": "string"
    },
    "anchor": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Anchor"
    },
    "budget": {
     "default": 3000,
     "title": "Budget",
     "type": "integer"
    },
    "surface": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Surface"
    },
    "session_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Session Id"
    }
   },
   "required": [
    "project_root"
   ],
   "title": "prepare_inheritanceArguments",
   "type": "object"
  },
  "outputSchema": {
   "properties": {
    "result": {
     "title": "Result",
     "type": "string"
    }
   },
   "required": [
    "result"
   ],
   "title": "prepare_inheritanceOutput",
   "type": "object"
  },
  "annotations": {
   "readOnlyHint": true,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false
  }
 },
 {
  "name": "discover_inheritance",
  "description": "Read available AetherMind context/anchor and must-know references.\n\n    This directory contains no layer bodies: full native inheritance has not\n    been delivered. Follow with prepare_inheritance for the required scope.\n    Does not initialize a store, alter history, or grant action authority.\n    ",
  "inputSchema": {
   "properties": {
    "project_root": {
     "title": "Project Root",
     "type": "string"
    },
    "surface": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Surface"
    },
    "session_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Session Id"
    }
   },
   "required": [
    "project_root"
   ],
   "title": "discover_inheritanceArguments",
   "type": "object"
  },
  "outputSchema": {
   "properties": {
    "result": {
     "title": "Result",
     "type": "string"
    }
   },
   "required": [
    "result"
   ],
   "title": "discover_inheritanceOutput",
   "type": "object"
  },
  "annotations": {
   "readOnlyHint": true,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false
  }
 },
 {
  "name": "verify_inheritance_use",
  "description": "Validate a use-evidence claim's shape and packet/session binding only.\n\n    Distinguishes delivered, recognized and applied claims. Evidence references\n    are not fetched or verified; a valid claim is not proof of comprehension,\n    permission, or successful action. No receipt is persisted, no debt is\n    cleared and no layer/currentness/authority state is changed.\n    ",
  "inputSchema": {
   "properties": {
    "envelope": {
     "additionalProperties": true,
     "title": "Envelope",
     "type": "object"
    },
    "receipt": {
     "additionalProperties": true,
     "title": "Receipt",
     "type": "object"
    }
   },
   "required": [
    "envelope",
    "receipt"
   ],
   "title": "verify_inheritance_useArguments",
   "type": "object"
  },
  "outputSchema": {
   "properties": {
    "result": {
     "title": "Result",
     "type": "string"
    }
   },
   "required": [
    "result"
   ],
   "title": "verify_inheritance_useOutput",
   "type": "object"
  },
  "annotations": {
   "readOnlyHint": true,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false
  }
 },
