 {
  "name": "read_layers",
  "description": "Return filtered layers as JSON.\n\n    Parameters mirror the core read_layers API. All filters are composable\n    (AND together):\n    - ctx: substring match against ctx (original behavior).\n    - type / author: exact match.\n    - since_ts: ISO-8601 UTC timestamp; only layers strictly newer than\n      this are returned.\n    - last_n: keep only the most recent N results (after other filters),\n      newest-first. Omit for the original oldest-first store order.\n    - ctx_prefix: path-segment prefix match against ctx (e.g. \"book4/ch2\"\n      matches \"book4/ch2/topic\" but not \"book4/ch2x/topic\").\n    - markers_any: include a layer if it has at least one of these markers.\n\n    Unfiltered reads on stores past ~40 layers are already unusable in\n    agent context windows; use these filters (or the `brief` tool) instead.\n    ",
  "inputSchema": {
   "properties": {
    "project_root": {
     "title": "Project Root",
     "type": "string"
    },
    "ctx": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Ctx"
    },
    "type": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Type"
    },
    "author": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Author"
    },
    "since_ts": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Since Ts"
    },
    "last_n": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Last N"
    },
    "ctx_prefix": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Ctx Prefix"
    },
    "markers_any": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Markers Any"
    }
   },
   "required": [
    "project_root"
   ],
   "title": "read_layersArguments",
   "type": "object"
  },
  "outputSchema": {
   "properties": {
    "result": {
     "title": "Result",
     "type": "string"
    }
   },
   "required": [
    "result"
   ],
   "title": "read_layersOutput",
   "type": "object"
  }
 },
